<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Products</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      margin: 0;
      padding: 0;
    }
    h1 {
      text-align: center;
      margin-top: 30px;
      color: #333;
    }
    .products-container {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 24px;
      margin: 40px auto;
      max-width: 1200px;
    }
    .product-card {
      background: #fff;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      padding: 24px;
      width: 260px;
      text-align: center;
      transition: box-shadow 0.2s;
    }
    .product-card:hover {
      box-shadow: 0 4px 16px rgba(0,0,0,0.15);
    }
    .product-card img {
      width: 100%;
      height: 160px;
      object-fit: cover;
      border-radius: 6px;
      margin-bottom: 16px;
    }
    .product-card h2 {
      font-size: 1.3em;
      margin: 10px 0 6px;
      color: #222;
    }
    .product-card h3 {
      font-size: 1em;
      color: #007bff;
      margin: 6px 0;
    }
    .product-card p {
      font-size: 0.95em;
      color: #555;
      margin-bottom: 18px;
    }
    .product-card button {
      background: #007bff;
      color: #fff;
      border: none;
      padding: 10px 20px;
      border-radius: 4px;
      cursor: pointer;
      font-size: 1em;
      transition: background 0.2s;
    }
    .product-card button:hover {
      background: #0056b3;
    }
  </style>
</head>
<body>
  <h1>Products</h1>
  <div class="products-container">
    <% products.forEach(product => { %>
      <div class="product-card">
        <img src="<%= product.image %>" alt="<%= product.name %>">
        <h2><%= product.name %></h2>
        <h3>Price: <%= product.price %></h3>
        <p><%= product.description %></p>
        <a href="/product/<%= product._id %>">
          <button type="button">View Product</button>
        </a>
      </div>
    <% }) %>
  </div>
</body>